# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/out

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env.local

# vercel
.vercel

# cloudflare / opennext
.open-next/
.wrangler/
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

.env

out.zip

tmp

# IDE
.vscode/
.idea/
# generated from config.yml (npm run config:generate)
# コミットしない。テンプレートとして複製したとき、前の組織の文言が残らないようにするため。
/src/lib/sites.generated.ts
/src/lib/app.generated.ts
/src/messages/ja.json
/src/messages/en.json
