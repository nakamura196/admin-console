{
  "name": "admin-console",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "sharp": "^0.35.5",
    "brace-expansion@1.1.18": "^1.1.21",
    "@node-minify/core": {
      "glob": "^13.0.0"
    }
  },
  "scripts": {
    "config:generate": "node scripts/generate-config.js",
    "dev": "npm run config:generate && next dev -p 3200",
    "dev:op": "op run --env-file=.env.local -- npm run dev",
    "build": "npm run config:generate && next build",
    "build:cloudflare": "npm run config:generate && npx @opennextjs/cloudflare build",
    "deploy": "npm run build:cloudflare && cp .open-next/worker.js .open-next/_worker.js && cp -r .open-next/assets/. .open-next/ && cp scripts/_routes.json .open-next/_routes.json && wrangler pages deploy .open-next --project-name=${CF_PAGES_PROJECT:-admin-console} --commit-dirty=true",
    "preview": "npm run build:cloudflare && wrangler dev",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/request": "^10.0.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.5.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.151.1"
  }
}
