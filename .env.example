# 必要な環境変数の一覧。
# ローカル開発: 値は 1Password に保存し、ここには op:// 参照だけを書いて
#               `npm run dev:op` (= op run --env-file=.env.local -- npm run dev) で注入する。
# 本番:         Cloudflare Pages の環境変数 (Secret) に設定する。
#
# 作業者の認証は Cloudflare Access (Zero Trust) が担当する。アプリ側にパスワードは持たない。

# === GitHub App (workflow_dispatch を叩くため) ===
# Repository permissions は Actions: Read and write のみでよい。
# installation は 1 つだけ = この管理コンソールは 1 つの GitHub 組織しか操作できない。
GITHUB_APP_ID=op://<vault>/<item>/app_id
GITHUB_INSTALLATION_ID=op://<vault>/<item>/installation_id
# PEM 全文（改行込み）
GITHUB_APP_PRIVATE_KEY=op://<vault>/<item>/private_key

# === Vercel Deploy Hook を使うアクションがある場合のみ ===
# config.yml の action.envHookKey に書いた名前と同じ変数を用意する。
# 例) envHookKey: EXAMPLE_SITE_DEPLOY_HOOK
# EXAMPLE_SITE_DEPLOY_HOOK=op://<vault>/<item>/deploy_hook_url

# === サイトメタデータ ===
# 配信先の URL。OGP と metadataBase に使う。
NEXT_PUBLIC_SITE_URL=https://example.pages.dev
# サブパスで配信する場合のみ設定（例: /admin）
NEXT_PUBLIC_BASE_PATH=

# === デプロイ (npm run deploy をローカルから実行する場合) ===
# Cloudflare Pages のプロジェクト名。未設定なら package.json の deploy スクリプトの既定値が使われる。
# CF_PAGES_PROJECT=<your-console>
